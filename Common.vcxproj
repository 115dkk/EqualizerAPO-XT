  <!-- CI always passes /p:EnableEnhancedInstructionSet per SIMD variant. A local
       msbuild without that property compiles the AVX2 project default, so state
       the effective x86 instruction set in the build output instead of letting a
       non-AVX2 machine discover it from a crash. -->
  <Target Name="ReportEnhancedInstructionSet" BeforeTargets="ClCompile" Condition="'$(Platform)'!='ARM64'">
    <PropertyGroup>
      <EffectiveEnhancedInstructionSet Condition="'$(EnableEnhancedInstructionSet)'!=''">$(EnableEnhancedInstructionSet)</EffectiveEnhancedInstructionSet>
      <EffectiveEnhancedInstructionSet Condition="'$(EnableEnhancedInstructionSet)'==''">AdvancedVectorExtensions2 (project default; pass /p:EnableEnhancedInstructionSet to override)</EffectiveEnhancedInstructionSet>
    </PropertyGroup>
    <Message Importance="high" Text="Common: x86 instruction set = $(EffectiveEnhancedInstructionSet)" />
  </Target>
</Project>
