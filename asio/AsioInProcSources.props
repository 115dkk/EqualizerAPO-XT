<?xml version="1.0" encoding="utf-8"?>
<!--
  The adapters that run the engine inside a test process: the in-process
  processor and the thread-backed host link. AsioTests and AsioProbe import
  this next to AsioCoreSources.props (audit #348 F13). The shared serving loop
  comes from AsioEngineHostSources.props below.
-->
<Project>
  <ItemGroup>
    <ClInclude Include="$(MSBuildThisFileDirectory)InProcProcessor.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)StreamEngineSetup.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)ThreadHostLink.h" />
    <ClCompile Include="$(MSBuildThisFileDirectory)InProcProcessor.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)ThreadHostLink.cpp" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)AsioEngineHostSources.props" />
</Project>
